<launch>
    <node name="camera_provider" pkg="camera_ros" type="camera_provider" output="screen">
        </node>

    <node pkg="tf" type="static_transform_publisher" name="base_to_right_cam" args="0 -0.255 0.24 0 1.57 0 base_link right_camera_link 100" />
    <node pkg="tf" type="static_transform_publisher" name="base_to_left_cam" args="0 0.255 0.24 0 1.57 0 base_link left_camera_link 100" />
    
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find camera_ros)/rviz/dual_cam.rviz" output="screen" />
</launch>
