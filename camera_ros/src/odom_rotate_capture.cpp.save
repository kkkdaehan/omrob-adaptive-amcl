#include <ros/ros.h>
#include <nav_msgs/Odometry.h>
#include <sensor_msgs/Image.h>
#include <geometry_msgs/Twist.h>
#include <std_srvs/Trigger.h>

#include <cv_bridge/cv_bridge.h>
#include <opencv2/opencv.hpp>

#include <cmath>
#include <string>
#include <sstream>
#include <iomanip>
#include <fstream>


class OdomRotateCapture
{
private:
    ros::NodeHandle nh_;
    ros::NodeHandle pnh_{"~"};

    ros::Subscriber odom_sub_, image_sub_;
    ros::Publisher cmd_pub_;
    ros::ServiceServer start_srv_;


    // =====================================================
    // Launch 파라미터
    // =====================================================

    std::string odom_topic_;
    std::string image_topic_;
    std::string cmd_topic_;
    std::string save_dir_;

    // left / right
    std::string rotation_direction_;

    // 총 회전각 [deg]
    double rotation_deg_;

    // 몇 도마다 이미지 + odom 저장 [deg]
    double capture_interval_deg_;

    // 회전 속도 [rad/s]
    double angular_speed_;

    // cmd_vel publish 주기 [Hz]
    double control_rate_;


    // =====================================================
    // 실제 odom
    // =====================================================

    double x_ = 0.0;
    double y_ = 0.0;
    double yaw_ = 0.0;

    double prev_yaw_ = 0.0;

    ros::Time odom_stamp_;


    // =====================================================
    // 서비스 호출 순간 기준 pose
    // =====================================================

    double start_x_ = 0.0;
    double start_y_ = 0.0;
    double start_yaw_ = 0.0;


    // =====================================================
    // 시작점 기준 상대 odom
    // =====================================================

    double relative_x_ = 0.0;
    double relative_y_ = 0.0;
    double relative_yaw_ = 0.0;


    // =====================================================
    // 회전량
    // =====================================================

    // 시작 이후 총 누적 회전량 [rad]
    double rotated_angle_ = 0.0;

    // 마지막 촬영 이후 누적 회전량 [rad]
    double capture_angle_ = 0.0;


    // =====================================================
    // 이미지
    // =====================================================

    cv::Mat latest_image_;
    ros::Time image_stamp_;

    int image_count_ = 0;


    // =====================================================
    // 상태
    // =====================================================

    bool odom_ready_ = false;
    bool image_ready_ = false;
    bool start_requested_ = false;
    bool running_ = false;


public:

    OdomRotateCapture()
    {
        // =============================
        // Topic
        // =============================

        pnh_.param<std::string>(
            "odom_topic",
            odom_topic_,
            "/odom"
        );

        pnh_.param<std::string>(
            "image_topic",
            image_topic_,
            "/camera/color/image_raw"
        );

        pnh_.param<std::string>(
            "cmd_vel_topic",
            cmd_topic_,
            "/cmd_vel"
        );


        // =============================
        // 저장 위치
        // =============================

        pnh_.param<std::string>(
            "save_dir",
            save_dir_,
            "/home/omrob/catkin_ws/src/camera_ros/src/연구실_회전_day0"
        );


        // =============================
        // 회전 설정
        // =============================

        // 총 회전각 [deg]
        pnh_.param(
            "rotation_deg",
            rotation_deg_,
            360.0
        );

        // 이미지 저장 간격 [deg]
        pnh_.param(
            "capture_interval_deg",
            capture_interval_deg_,
            5.0
        );

        // 회전 속도 [rad/s]
        pnh_.param(
            "angular_speed",
            angular_speed_,
            0.1853020188851842
        );

        // left 또는 right
        pnh_.param<std::string>(
            "rotation_direction",
            rotation_direction_,
            "left"
        );

        // 제어 주기
        pnh_.param(
            "control_rate",
            control_rate_,
            20.0
        );


        // =============================
        // ROS
        // =============================

        odom_sub_ = nh_.subscribe(
            odom_topic_,
            20,
            &OdomRotateCapture::odomCallback,
            this
        );

        image_sub_ = nh_.subscribe(
            image_topic_,
            1,
            &OdomRotateCapture::imageCallback,
            this
        );

        cmd_pub_ = nh_.advertise<geometry_msgs::Twist>(
            cmd_topic_,
            10
        );

        // 서비스:
        // /odom_rotate_capture/start
        start_srv_ = pnh_.advertiseService(
            "start",
            &OdomRotateCapture::startCallback,
            this
        );


        ROS_INFO("====================================");
        ROS_INFO("ROTATION IMAGE CAPTURE");
        ROS_INFO("Rotation      : %.1f deg", rotation_deg_);
        ROS_INFO("Capture       : %.1f deg", capture_interval_deg_);
        ROS_INFO("Angular speed : %.6f rad/s", angular_speed_);
        ROS_INFO("Direction     : %s", rotation_direction_.c_str());
        ROS_INFO("Save dir      : %s", save_dir_.c_str());
        ROS_INFO("====================================");
    }


    ~OdomRotateCapture()
    {
        stopRobot();
    }


    // =====================================================
    // Quaternion -> yaw
    // =====================================================

    double getYaw(const geometry_msgs::Quaternion& q)
    {
        return std::atan2(
            2.0 * (q.w * q.z + q.x * q.y),
            1.0 - 2.0 * (q.y * q.y + q.z * q.z)
        );
    }


    // =====================================================
    // 각도 -pi ~ +pi 정규화
    // =====================================================

    double normalizeAngle(double angle)
    {
        while (angle > M_PI)
            angle -= 2.0 * M_PI;

        while (angle < -M_PI)
            angle += 2.0 * M_PI;

        return angle;
    }


    // =====================================================
    // Camera callback
    // =====================================================

    void imageCallback(
        const sensor_msgs::ImageConstPtr& msg
    )
    {
        try
        {
            latest_image_ =
                cv_bridge::toCvShare(
                    msg,
                    "bgr8"
                )->image.clone();

            image_stamp_ = msg->header.stamp;
            image_ready_ = true;
        }
        catch (cv_bridge::Exception& e)
        {
            ROS_ERROR(
                "cv_bridge: %s",
                e.what()
            );
        }
    }


    // =====================================================
    // Odom callback
    // =====================================================

    void odomCallback(
        const nav_msgs::Odometry::ConstPtr& msg
    )
    {
        x_ = msg->pose.pose.position.x;
        y_ = msg->pose.pose.position.y;

        yaw_ =
            getYaw(
                msg->pose.pose.orientation
            );

        odom_stamp_ =
            msg->header.stamp;


        // 최초 odom
        if (!odom_ready_)
        {
            prev_yaw_ = yaw_;

            odom_ready_ = true;

            ROS_INFO("ODOM READY");

            return;
        }


        // 아직 시작 전이면 현재 yaw만 계속 갱신
        if (!running_)
        {
            prev_yaw_ = yaw_;
            return;
        }


        // =================================================
        // 직전 yaw → 현재 yaw 변화량
        // =================================================

        double delta_yaw =
            normalizeAngle(
                yaw_ - prev_yaw_
            );

        prev_yaw_ = yaw_;


        // 방향 상관없이 실제 회전한 양
        double abs_delta =
            std::fabs(delta_yaw);


        // 총 회전량
        rotated_angle_ += abs_delta;

        // 촬영용 회전량
        capture_angle_ += abs_delta;


        // =================================================
        // 시작점 기준 상대 pose
        // =================================================

        double dx =
            x_ - start_x_;

        double dy =
            y_ - start_y_;


        relative_x_ =
            std::cos(start_yaw_) * dx +
            std::sin(start_yaw_) * dy;

        relative_y_ =
            -std::sin(start_yaw_) * dx +
             std::cos(start_yaw_) * dy;


        // 현재 방향은 -180 ~ +180 범위
        relative_yaw_ =
            normalizeAngle(
                yaw_ - start_yaw_
            );


        // =================================================
        // 일정 각도마다 저장
        // =================================================

        double interval_rad =
            capture_interval_deg_
            * M_PI
            / 180.0;


        if (capture_angle_ >= interval_rad)
        {
            saveData();

            // 초과된 회전량을 남겨서 누적 오차 감소
            capture_angle_ -= interval_rad;
        }
    }


    // =====================================================
    // START 서비스
    // =====================================================

    bool startCallback(
        std_srvs::Trigger::Request& req,
        std_srvs::Trigger::Response& res
    )
    {
        if (!odom_ready_)
        {
            res.success = false;
            res.message = "ODOM not ready";
            return true;
        }


        if (!image_ready_)
        {
            res.success = false;
            res.message = "CAMERA not ready";
            return true;
        }


        if (running_ || start_requested_)
        {
            res.success = false;
            res.message = "Already running";
            return true;
        }


        start_requested_ = true;

        res.success = true;
        res.message = "ROTATION START requested";


        ROS_WARN("START SERVICE RECEIVED");

        return true;
    }


    // =====================================================
    // 서비스 호출 순간을 0도로 설정
    // =====================================================

    void resetOdomReference()
    {
        start_x_ = x_;
        start_y_ = y_;
        start_yaw_ = yaw_;

        prev_yaw_ = yaw_;

        relative_x_ = 0.0;
        relative_y_ = 0.0;
        relative_yaw_ = 0.0;

        rotated_angle_ = 0.0;
        capture_angle_ = 0.0;

        image_count_ = 0;


        ROS_WARN("====================================");
        ROS_WARN("ODOM ROTATION RESET");
        ROS_WARN("x   = 0.000");
        ROS_WARN("y   = 0.000");
        ROS_WARN("yaw = 0.000 deg");
        ROS_WARN("====================================");
    }


    // =====================================================
    // 이미지 + odom 저장
    // =====================================================

    void saveData()
    {
        if (!image_ready_ || latest_image_.empty())
            return;


        // image_0000 공통 파일명
        std::stringstream ss;

        ss << save_dir_
           << "/image_"
           << std::setw(4)
           << std::setfill('0')
           << image_count_;


        std::string base =
            ss.str();

        std::string jpg_file =
            base + ".jpg";

        std::string txt_file =
            base + ".txt";


        // =============================
        // JPG
        // =============================

        if (!cv::imwrite(
                jpg_file,
                latest_image_
            ))
        {
            ROS_ERROR(
                "Image save failed: %s",
                jpg_file.c_str()
            );

            return;
        }


        // =============================
        // TXT
        // =============================

        std::ofstream file(
            txt_file
        );

        if (!file.is_open())
        {
            ROS_ERROR(
                "TXT save failed: %s",
                txt_file.c_str()
            );

            return;
        }


        file
            << std::fixed
            << std::setprecision(9);


        file << "[IMAGE]\n";

        file << "timestamp: "
             << image_stamp_.toSec()
             << "\n\n";


        file << "[ODOMETRY]\n";

        file << "timestamp: "
             << odom_stamp_.toSec()
             << "\n";

        file << "x: "
             << relative_x_
             << "\n";

        file << "y: "
             << relative_y_
             << "\n";

        // 현재 방향 (-180 ~ +180)
        file << "yaw_rad: "
             << relative_yaw_
             << "\n";

        file << "yaw_deg: "
             << relative_yaw_
                * 180.0 / M_PI
             << "\n";


        // 실제 누적 회전량
        // 360도 회전이면 0~360까지 계속 증가
        file << "rotated_deg: "
             << rotated_angle_
                * 180.0 / M_PI
             << "\n";


        file << "direction: "
             << rotation_direction_
             << "\n";


        file.close();


        ROS_INFO(
            "SAVE %04d | rotated %.1f deg | yaw %.1f deg",
            image_count_,
            rotated_angle_ * 180.0 / M_PI,
            relative_yaw_ * 180.0 / M_PI
        );


        image_count_++;
    }


    // =====================================================
    // cmd_vel
    // =====================================================

    void publishCmd(double angular)
    {
        geometry_msgs::Twist cmd;

        // 제자리 회전
        cmd.linear.x = 0.0;

        cmd.angular.z = angular;

        cmd_pub_.publish(cmd);
    }


    void stopRobot()
    {
        publishCmd(0.0);
    }


    // =====================================================
    // 회전
    // =====================================================

    void rotateRobot()
    {
        double target_rad =
            rotation_deg_
            * M_PI
            / 180.0;


        // ROS 기준
        // +angular.z = LEFT (CCW)
        // -angular.z = RIGHT (CW)

        double command_speed;


        if (
            rotation_direction_ == "right" ||
            rotation_direction_ == "RIGHT"
        )
        {
            command_speed =
                -std::fabs(angular_speed_);
        }
        else
        {
            command_speed =
                std::fabs(angular_speed_);
        }


        ros::Rate rate(
            control_rate_
        );


        ROS_WARN("====================================");
        ROS_WARN("ROTATION START");
        ROS_WARN("Target    : %.1f deg", rotation_deg_);
        ROS_WARN("Direction : %s", rotation_direction_.c_str());
        ROS_WARN("Speed     : %.6f rad/s", command_speed);
        ROS_WARN("====================================");


        while (
            ros::ok() &&
            rotated_angle_ < target_rad
        )
        {
            ros::spinOnce();

            publishCmd(
                command_speed
            );


            ROS_INFO_THROTTLE(
                0.5,
                "ROTATING %.1f / %.1f deg | cmd %.6f",
                rotated_angle_ * 180.0 / M_PI,
                rotation_deg_,
                command_speed
            );


            rate.sleep();
        }


        // 확실하게 정지
        for (int i = 0; i < 10; i++)
        {
            stopRobot();

            ros::spinOnce();

            rate.sleep();
        }


        ROS_WARN("====================================");
        ROS_WARN("ROTATION COMPLETE");
        ROS_WARN(
            "Rotated : %.1f deg",
            rotated_angle_ * 180.0 / M_PI
        );
        ROS_WARN(
            "Saved   : %d",
            image_count_
        );
        ROS_WARN("====================================");
    }


    // =====================================================
    // Main
    // =====================================================

    void run()
    {
        ros::Rate rate(20);


        // Odom + Camera 준비
        while (
            ros::ok() &&
            (!odom_ready_ || !image_ready_)
        )
        {
            ros::spinOnce();

            ROS_INFO_THROTTLE(
                1.0,
                "Waiting ODOM / CAMERA..."
            );

            rate.sleep();
        }


        ROS_INFO("====================================");
        ROS_INFO("ODOM READY");
        ROS_INFO("CAMERA READY");
        ROS_INFO("WAITING START SERVICE");
        ROS_INFO(
            "rosservice call /odom_rotate_capture/start"
        );
        ROS_INFO("====================================");


        // 서비스 호출 대기
        while (
            ros::ok() &&
            !start_requested_
        )
        {
            ros::spinOnce();
            rate.sleep();
        }


        if (!ros::ok())
            return;


        // 최신 odom 한 번 반영
        ros::spinOnce();


        // 서비스 호출 순간 yaw = 0
        resetOdomReference();


        running_ = true;


        // 회전 시작
        rotateRobot();


        running_ = false;

        stopRobot();
    }
};


int main(int argc, char** argv)
{
    ros::init(
        argc,
        argv,
        "odom_rotate_capture"
    );


    OdomRotateCapture node;

    node.run();

    return 0;
}#include <ros/ros.h>
#include <nav_msgs/Odometry.h>
#include <sensor_msgs/Image.h>
#include <geometry_msgs/Twist.h>
#include <std_srvs/Trigger.h>

#include <cv_bridge/cv_bridge.h>
#include <opencv2/opencv.hpp>

#include <cmath>
#include <string>
#include <sstream>
#include <iomanip>
#include <fstream>


class OdomRotateCapture
{
private:
    ros::NodeHandle nh_;
    ros::NodeHandle pnh_{"~"};

    ros::Subscriber odom_sub_, image_sub_;
    ros::Publisher cmd_pub_;
    ros::ServiceServer start_srv_;


    // =====================================================
    // Launch 파라미터
    // =====================================================

    std::string odom_topic_;
    std::string image_topic_;
    std::string cmd_topic_;
    std::string save_dir_;

    // left / right
    std::string rotation_direction_;

    // 총 회전각 [deg]
    double rotation_deg_;

    // 몇 도마다 이미지 + odom 저장 [deg]
    double capture_interval_deg_;

    // 회전 속도 [rad/s]
    double angular_speed_;

    // cmd_vel publish 주기 [Hz]
    double control_rate_;


    // =====================================================
    // 실제 odom
    // =====================================================

    double x_ = 0.0;
    double y_ = 0.0;
    double yaw_ = 0.0;

    double prev_yaw_ = 0.0;

    ros::Time odom_stamp_;


    // =====================================================
    // 서비스 호출 순간 기준 pose
    // =====================================================

    double start_x_ = 0.0;
    double start_y_ = 0.0;
    double start_yaw_ = 0.0;


    // =====================================================
    // 시작점 기준 상대 odom
    // =====================================================

    double relative_x_ = 0.0;
    double relative_y_ = 0.0;
    double relative_yaw_ = 0.0;


    // =====================================================
    // 회전량
    // =====================================================

    // 시작 이후 총 누적 회전량 [rad]
    double rotated_angle_ = 0.0;

    // 마지막 촬영 이후 누적 회전량 [rad]
    double capture_angle_ = 0.0;


    // =====================================================
    // 이미지
    // =====================================================

    cv::Mat latest_image_;
    ros::Time image_stamp_;

    int image_count_ = 0;


    // =====================================================
    // 상태
    // =====================================================

    bool odom_ready_ = false;
    bool image_ready_ = false;
    bool start_requested_ = false;
    bool running_ = false;


public:

    OdomRotateCapture()
    {
        // =============================
        // Topic
        // =============================

        pnh_.param<std::string>(
            "odom_topic",
            odom_topic_,
            "/odom"
        );

        pnh_.param<std::string>(
            "image_topic",
            image_topic_,
            "/camera/color/image_raw"
        );

        pnh_.param<std::string>(
            "cmd_vel_topic",
            cmd_topic_,
            "/cmd_vel"
        );


        // =============================
        // 저장 위치
        // =============================

        pnh_.param<std::string>(
            "save_dir",
            save_dir_,
            "/home/omrob/catkin_ws/src/camera_ros/src/연구실_회전_day0"
        );


        // =============================
        // 회전 설정
        // =============================

        // 총 회전각 [deg]
        pnh_.param(
            "rotation_deg",
            rotation_deg_,
            360.0
        );

        // 이미지 저장 간격 [deg]
        pnh_.param(
            "capture_interval_deg",
            capture_interval_deg_,
            5.0
        );

        // 회전 속도 [rad/s]
        pnh_.param(
            "angular_speed",
            angular_speed_,
            0.1853020188851842
        );

        // left 또는 right
        pnh_.param<std::string>(
            "rotation_direction",
            rotation_direction_,
            "left"
        );

        // 제어 주기
        pnh_.param(
            "control_rate",
            control_rate_,
            20.0
        );


        // =============================
        // ROS
        // =============================

        odom_sub_ = nh_.subscribe(
            odom_topic_,
            20,
            &OdomRotateCapture::odomCallback,
            this
        );

        image_sub_ = nh_.subscribe(
            image_topic_,
            1,
            &OdomRotateCapture::imageCallback,
            this
        );

        cmd_pub_ = nh_.advertise<geometry_msgs::Twist>(
            cmd_topic_,
            10
        );

        // 서비스:
        // /odom_rotate_capture/start
        start_srv_ = pnh_.advertiseService(
            "start",
            &OdomRotateCapture::startCallback,
            this
        );


        ROS_INFO("====================================");
        ROS_INFO("ROTATION IMAGE CAPTURE");
        ROS_INFO("Rotation      : %.1f deg", rotation_deg_);
        ROS_INFO("Capture       : %.1f deg", capture_interval_deg_);
        ROS_INFO("Angular speed : %.6f rad/s", angular_speed_);
        ROS_INFO("Direction     : %s", rotation_direction_.c_str());
        ROS_INFO("Save dir      : %s", save_dir_.c_str());
        ROS_INFO("====================================");
    }


    ~OdomRotateCapture()
    {
        stopRobot();
    }


    // =====================================================
    // Quaternion -> yaw
    // =====================================================

    double getYaw(const geometry_msgs::Quaternion& q)
    {
        return std::atan2(
            2.0 * (q.w * q.z + q.x * q.y),
            1.0 - 2.0 * (q.y * q.y + q.z * q.z)
        );
    }


    // =====================================================
    // 각도 -pi ~ +pi 정규화
    // =====================================================

    double normalizeAngle(double angle)
    {
        while (angle > M_PI)
            angle -= 2.0 * M_PI;

        while (angle < -M_PI)
            angle += 2.0 * M_PI;

        return angle;
    }


    // =====================================================
    // Camera callback
    // =====================================================

    void imageCallback(
        const sensor_msgs::ImageConstPtr& msg
    )
    {
        try
        {
            latest_image_ =
                cv_bridge::toCvShare(
                    msg,
                    "bgr8"
                )->image.clone();

            image_stamp_ = msg->header.stamp;
            image_ready_ = true;
        }
        catch (cv_bridge::Exception& e)
        {
            ROS_ERROR(
                "cv_bridge: %s",
                e.what()
            );
        }
    }


    // =====================================================
    // Odom callback
    // =====================================================

    void odomCallback(
        const nav_msgs::Odometry::ConstPtr& msg
    )
    {
        x_ = msg->pose.pose.position.x;
        y_ = msg->pose.pose.position.y;

        yaw_ =
            getYaw(
                msg->pose.pose.orientation
            );

        odom_stamp_ =
            msg->header.stamp;


        // 최초 odom
        if (!odom_ready_)
        {
            prev_yaw_ = yaw_;

            odom_ready_ = true;

            ROS_INFO("ODOM READY");

            return;
        }


        // 아직 시작 전이면 현재 yaw만 계속 갱신
        if (!running_)
        {
            prev_yaw_ = yaw_;
            return;
        }


        // =================================================
        // 직전 yaw → 현재 yaw 변화량
        // =================================================

        double delta_yaw =
            normalizeAngle(
                yaw_ - prev_yaw_
            );

        prev_yaw_ = yaw_;


        // 방향 상관없이 실제 회전한 양
        double abs_delta =
            std::fabs(delta_yaw);


        // 총 회전량
        rotated_angle_ += abs_delta;

        // 촬영용 회전량
        capture_angle_ += abs_delta;


        // =================================================
        // 시작점 기준 상대 pose
        // =================================================

        double dx =
            x_ - start_x_;

        double dy =
            y_ - start_y_;


        relative_x_ =
            std::cos(start_yaw_) * dx +
            std::sin(start_yaw_) * dy;

        relative_y_ =
            -std::sin(start_yaw_) * dx +
             std::cos(start_yaw_) * dy;


        // 현재 방향은 -180 ~ +180 범위
        relative_yaw_ =
            normalizeAngle(
                yaw_ - start_yaw_
            );


        // =================================================
        // 일정 각도마다 저장
        // =================================================

        double interval_rad =
            capture_interval_deg_
            * M_PI
            / 180.0;


        if (capture_angle_ >= interval_rad)
        {
            saveData();

            // 초과된 회전량을 남겨서 누적 오차 감소
            capture_angle_ -= interval_rad;
        }
    }


    // =====================================================
    // START 서비스
    // =====================================================

    bool startCallback(
        std_srvs::Trigger::Request& req,
        std_srvs::Trigger::Response& res
    )
    {
        if (!odom_ready_)
        {
            res.success = false;
            res.message = "ODOM not ready";
            return true;
        }


        if (!image_ready_)
        {
            res.success = false;
            res.message = "CAMERA not ready";
            return true;
        }


        if (running_ || start_requested_)
        {
            res.success = false;
            res.message = "Already running";
            return true;
        }


        start_requested_ = true;

        res.success = true;
        res.message = "ROTATION START requested";


        ROS_WARN("START SERVICE RECEIVED");

        return true;
    }


    // =====================================================
    // 서비스 호출 순간을 0도로 설정
    // =====================================================

    void resetOdomReference()
    {
        start_x_ = x_;
        start_y_ = y_;
        start_yaw_ = yaw_;

        prev_yaw_ = yaw_;

        relative_x_ = 0.0;
        relative_y_ = 0.0;
        relative_yaw_ = 0.0;

        rotated_angle_ = 0.0;
        capture_angle_ = 0.0;

        image_count_ = 0;


        ROS_WARN("====================================");
        ROS_WARN("ODOM ROTATION RESET");
        ROS_WARN("x   = 0.000");
        ROS_WARN("y   = 0.000");
        ROS_WARN("yaw = 0.000 deg");
        ROS_WARN("====================================");
    }


    // =====================================================
    // 이미지 + odom 저장
    // =====================================================

    void saveData()
    {
        if (!image_ready_ || latest_image_.empty())
            return;


        // image_0000 공통 파일명
        std::stringstream ss;

        ss << save_dir_
           << "/image_"
           << std::setw(4)
           << std::setfill('0')
           << image_count_;


        std::string base =
            ss.str();

        std::string jpg_file =
            base + ".jpg";

        std::string txt_file =
            base + ".txt";


        // =============================
        // JPG
        // =============================

        if (!cv::imwrite(
                jpg_file,
                latest_image_
            ))
        {
            ROS_ERROR(
                "Image save failed: %s",
                jpg_file.c_str()
            );

            return;
        }


        // =============================
        // TXT
        // =============================

        std::ofstream file(
            txt_file
        );

        if (!file.is_open())
        {
            ROS_ERROR(
                "TXT save failed: %s",
                txt_file.c_str()
            );

            return;
        }


        file
            << std::fixed
            << std::setprecision(9);


        file << "[IMAGE]\n";

        file << "timestamp: "
             << image_stamp_.toSec()
             << "\n\n";


        file << "[ODOMETRY]\n";

        file << "timestamp: "
             << odom_stamp_.toSec()
             << "\n";

        file << "x: "
             << relative_x_
             << "\n";

        file << "y: "
             << relative_y_
             << "\n";

        // 현재 방향 (-180 ~ +180)
        file << "yaw_rad: "
             << relative_yaw_
             << "\n";

        file << "yaw_deg: "
             << relative_yaw_
                * 180.0 / M_PI
             << "\n";


        // 실제 누적 회전량
        // 360도 회전이면 0~360까지 계속 증가
        file << "rotated_deg: "
             << rotated_angle_
                * 180.0 / M_PI
             << "\n";


        file << "direction: "
             << rotation_direction_
             << "\n";


        file.close();


        ROS_INFO(
            "SAVE %04d | rotated %.1f deg | yaw %.1f deg",
            image_count_,
            rotated_angle_ * 180.0 / M_PI,
            relative_yaw_ * 180.0 / M_PI
        );


        image_count_++;
    }


    // =====================================================
    // cmd_vel
    // =====================================================

    void publishCmd(double angular)
    {
        geometry_msgs::Twist cmd;

        // 제자리 회전
        cmd.linear.x = 0.0;

        cmd.angular.z = angular;

        cmd_pub_.publish(cmd);
    }


    void stopRobot()
    {
        publishCmd(0.0);
    }


    // =====================================================
    // 회전
    // =====================================================

    void rotateRobot()
    {
        double target_rad =
            rotation_deg_
            * M_PI
            / 180.0;


        // ROS 기준
        // +angular.z = LEFT (CCW)
        // -angular.z = RIGHT (CW)

        double command_speed;


        if (
            rotation_direction_ == "right" ||
            rotation_direction_ == "RIGHT"
        )
        {
            command_speed =
                -std::fabs(angular_speed_);
        }
        else
        {
            command_speed =
                std::fabs(angular_speed_);
        }


        ros::Rate rate(
            control_rate_
        );


        ROS_WARN("====================================");
        ROS_WARN("ROTATION START");
        ROS_WARN("Target    : %.1f deg", rotation_deg_);
        ROS_WARN("Direction : %s", rotation_direction_.c_str());
        ROS_WARN("Speed     : %.6f rad/s", command_speed);
        ROS_WARN("====================================");


        while (
            ros::ok() &&
            rotated_angle_ < target_rad
        )
        {
            ros::spinOnce();

            publishCmd(
                command_speed
            );


            ROS_INFO_THROTTLE(
                0.5,
                "ROTATING %.1f / %.1f deg | cmd %.6f",
                rotated_angle_ * 180.0 / M_PI,
                rotation_deg_,
                command_speed
            );


            rate.sleep();
        }


        // 확실하게 정지
        for (int i = 0; i < 10; i++)
        {
            stopRobot();

            ros::spinOnce();

            rate.sleep();
        }


        ROS_WARN("====================================");
        ROS_WARN("ROTATION COMPLETE");
        ROS_WARN(
            "Rotated : %.1f deg",
            rotated_angle_ * 180.0 / M_PI
        );
        ROS_WARN(
            "Saved   : %d",
            image_count_
        );
        ROS_WARN("====================================");
    }


    // =====================================================
    // Main
    // =====================================================

    void run()
    {
        ros::Rate rate(20);


        // Odom + Camera 준비
        while (
            ros::ok() &&
            (!odom_ready_ || !image_ready_)
        )
        {
            ros::spinOnce();

            ROS_INFO_THROTTLE(
                1.0,
                "Waiting ODOM / CAMERA..."
            );

            rate.sleep();
        }


        ROS_INFO("====================================");
        ROS_INFO("ODOM READY");
        ROS_INFO("CAMERA READY");
        ROS_INFO("WAITING START SERVICE");
        ROS_INFO(
            "rosservice call /odom_rotate_capture/start"
        );
        ROS_INFO("====================================");


        // 서비스 호출 대기
        while (
            ros::ok() &&
            !start_requested_
        )
        {
            ros::spinOnce();
            rate.sleep();
        }


        if (!ros::ok())
            return;


        // 최신 odom 한 번 반영
        ros::spinOnce();


        // 서비스 호출 순간 yaw = 0
        resetOdomReference();


        running_ = true;


        // 회전 시작
        rotateRobot();


        running_ = false;

        stopRobot();
    }
};


int main(int argc, char** argv)
{
    ros::init(
        argc,
        argv,
        "odom_rotate_capture"
    );


    OdomRotateCapture node;

    node.run();

    return 0;
}
